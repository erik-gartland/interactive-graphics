<html lang="en" data-no-font-kit>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Housing Supply and Rental Assistance</title>
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="A scrolling, chart-led version of the CBPP report on housing supply and rental assistance.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800&family=Montserrat:wght@400;500;600;700;800&family=Barlow+Semi+Condensed:wght@300;400;500;600;700&family=Red+Hat+Display:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
<script>
  // free-fonts until Proxima Nova actually loads; ?fonts=free previews the backups even where the kit works
  document.documentElement.classList.add('free-fonts');
  if (/[?&]fonts=free\b/.test(location.search)) document.getElementById('cbpp-kit')?.remove();
  else if (document.fonts) {
    const check = () => { if ([...document.fonts].some(f => /proxima/.test(f.family) && f.status === 'loaded')) document.documentElement.classList.remove('free-fonts'); };
    document.fonts.addEventListener('loadingdone', check);
    document.fonts.ready.then(check);
  }
</script>
<style>
/* ---------- CBPP tokens (from cbpp.org theme CSS) ---------- */
:root {
  --cbpp-header-font: "Figtree", "Helvetica", "Arial", sans-serif;
  --cbpp-main-font: "Red Hat Display", "Helvetica", "Arial", sans-serif;
  /* CBPP's charts are set in Proxima Nova, served by CBPP's Adobe Fonts kit where it's allowed.
     Free stand-ins: Montserrat (regular) paired with Barlow Semi Condensed (condensed), whose tall
     x-height sits well next to Montserrat. */
  --chart-font: "proxima-nova", "Proxima Nova", "Montserrat", "Helvetica", "Arial", sans-serif;
  /* CBPP's PNGs set subtitles, legends, labels and values in Proxima Nova Condensed */
  --chart-font-cond: "proxima-nova-condensed", "Proxima Nova Condensed", "Barlow Semi Condensed", "Arial Narrow", sans-serif;
  --ink: #1c1c1c;
  --ink-2: #4a4a4a;
  --ink-3: #7a7979;
  --rule: #cfcfcf;
  --rule-light: #e4e4e4;
  --paper: #ffffff;
  --paper-warm: #fffcf1;
  --gold-grad: #f9edd4;
  --dark-blue: #032a4b;
  --med-blue: #003767;
  --link: #0c61a4;
  --yellow: #febd57;
  --teal: #176362;
  --light-gold: #ffdeab;
  --dim: 0.22;
  --t: 600ms;
  --ease: cubic-bezier(.4, 0, .2, 1);
}
@media (prefers-reduced-motion: reduce) { :root { --t: 0ms; } }

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--paper); color: var(--ink);
  /* CBPP report body text (.field--name-body): 18px / 1.777, weight 500, 0.01em tracking */
  font-family: var(--cbpp-main-font); font-size: 18px; line-height: 1.777; font-weight: 500; letter-spacing: .01em;
}
a { color: var(--link); }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* ---------- masthead + hero ---------- */
.masthead a { display: inline-block; line-height: 0; }
.masthead img { height: 76px; width: auto; }
@media (max-width: 899px) { .masthead img { height: 58px; } }
.masthead {
  border-bottom: 1px solid var(--rule); padding: 12px 16px; text-align: center;
  font-family: var(--cbpp-header-font); font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; font-size: 13px; color: var(--dark-blue);
}
.hero { max-width: 760px; margin: 0 auto; padding: 56px 16px 24px; }
.tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; padding: 0; list-style: none; }
.tags li {
  font-family: var(--cbpp-header-font); font-weight: 700; text-transform: uppercase;
  letter-spacing: .08em; font-size: 12px; line-height: 1; color: var(--med-blue);
  border: 1.5px solid var(--med-blue); border-radius: 3px; padding: 6px 10px;
}
.tags li:first-child { background: var(--med-blue); color: #fff; }
.hero h1 {
  font-family: var(--cbpp-header-font); font-weight: 700; font-size: 40px;
  line-height: 48px; letter-spacing: 0; margin: 0 0 18px; text-wrap: balance;
}
.dek { font-size: clamp(19px, 2.4vw, 22px); line-height: 1.45; color: var(--ink-2); margin: 0 0 22px; }
.byline { font-family: var(--cbpp-header-font); font-size: 14px; color: var(--ink-3); border-top: 1px solid var(--rule-light); padding-top: 12px; }
.byline strong { color: var(--ink); }
.byline-note { position: relative; font-family: var(--cbpp-header-font); font-size: 14px; line-height: 1.5; color: #9b9a99; margin: 16px 0 0; padding: 6px 18px; }
.byline-note a { color: inherit; }
/* tall square brackets that wrap the whole note, however many lines it runs to */
.byline-note::before, .byline-note::after { content: ""; position: absolute; top: 0; bottom: 0; width: 7px; border: 1.5px solid #c2c0bd; }
.byline-note::before { left: 0; border-right: 0; }
.byline-note::after { right: 0; border-left: 0; }
.toc { max-width: 760px; margin: 8px auto 8px; padding: 0 16px; }
.toc-head { font-family: var(--cbpp-header-font); font-weight: 700; font-size: 16px; margin: 0 0 6px; }
.toc ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-light); }
.toc li { border-bottom: 1px solid var(--rule-light); }
.toc a { display: flex; gap: 12px; padding: 9px 0; color: var(--ink); text-decoration: none; font-family: var(--cbpp-header-font); font-size: 16px; line-height: 1.35; }
.toc .toc-t { color: var(--ink-3); transition: color 120ms; }
.toc .toc-n { transition: color 120ms; }
.toc a:hover .toc-n, .toc a:focus-visible .toc-n { color: var(--ink-3); font-weight: 700; }
.toc a:hover .toc-t, .toc a:focus-visible .toc-t { color: var(--ink); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.toc .toc-n { flex: 0 0 48px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

/* ---------- prose blocks ---------- */
.prose { max-width: 640px; margin: 0 auto; padding: 24px 16px; }
.prose h2 {
  /* one heading size, a step up from body text (a scrolly, not a report page) */
  font-family: var(--cbpp-header-font); font-weight: 700; font-size: 24px; letter-spacing: 0;
  line-height: 1.3; margin: 32px 0 12px;
}
.prose p { margin: 0 0 18px; }
.prose + .prose { padding-top: 0; }
.prose > h2:first-child { margin-top: 8px; }

/* ---------- scrolly ---------- */
.scrolly { overflow-x: clip; position: relative; display: grid; grid-template-columns: minmax(300px, 380px) minmax(0, 1fr); gap: 40px; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.graphic { grid-column: 2; grid-row: 1; position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; }
.steps { grid-column: 1; grid-row: 1; position: relative; z-index: 2; padding: 30vh 0 40vh; }
.step { min-height: 80vh; display: flex; align-items: center; }
.step:last-child { min-height: 60vh; }
.step-card {
  background: var(--paper); border: 1px solid var(--rule); border-radius: 6px;
  padding: 18px 20px; font-size: inherit; line-height: inherit; box-shadow: 0 2px 10px rgba(0,0,0,.06);
  opacity: .35; transition: opacity var(--t) var(--ease);
}
.step.is-active .step-card { opacity: 1; }
.step-card.pause { visibility: hidden; min-height: 120px; }
.step-card p { margin: 0 0 10px; } .step-card p:last-child { margin: 0; }
.step-card strong, .prose strong { font-weight: 700; background: linear-gradient(transparent 60%, var(--hl) 60%); }
a.src { color: inherit; text-decoration: underline; text-decoration-color: var(--ink-3); text-decoration-thickness: 1px; text-underline-offset: 3px; }
a.src:hover { text-decoration-color: var(--ink); }
/* Source style "underline" (meta.sourceStyle, or the editor's Sources switch): the key
   phrases drop the highlighter for a plain underline that turns link-blue on hover */
html.src-underline:root :is(.step-card, .prose, .dek) strong { background: none; text-decoration: underline solid var(--ink-3); text-decoration-thickness: 1px; text-underline-offset: 3px; transition: color 120ms, text-decoration-color 120ms; }
html.src-underline:root :is(.step-card, .prose, .dek) strong:is([data-note], [data-src-text], [data-ed-note]):is(:hover, :focus-visible) { color: var(--link); text-decoration-color: var(--link); }
/* highlighted phrases carry their report endnote; hovering (or tapping) shows it */
strong[data-note], strong[data-src-text], strong[data-ed-note] { cursor: help; text-decoration: underline dotted var(--ink-3); text-decoration-thickness: 1px; text-underline-offset: 4px; outline: none; }
strong[data-note]:hover, strong[data-note]:focus-visible, strong[data-src-text]:focus-visible, strong[data-ed-note]:hover, strong[data-ed-note]:focus-visible { text-decoration-color: var(--ink); }
.notebox { position: absolute; z-index: 40; width: min(380px, calc(100vw - 24px)); background: var(--paper); color: var(--ink); border: 1px solid var(--rule); border-radius: 6px; box-shadow: 0 8px 28px rgba(0,0,0,.16); padding: 12px 14px; font-family: var(--cbpp-header-font); font-size: 14px; line-height: 1.45; letter-spacing: 0; font-weight: 400; opacity: 0; pointer-events: none; transform: translateY(4px); transition: opacity 120ms, transform 120ms; }
.notebox.on { opacity: 1; pointer-events: auto; transform: none; }
.notebox .nb-item + .nb-item { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--rule-light); }
/* status tag above each citation: small caps-style pills, readable at a glance */
.notebox .nb-tag { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; line-height: 1; padding: 3px 6px 3px; border-radius: 3px; margin: 0 0 6px; }
.notebox .nb-tag.ok { background: #e2f1e4; color: #1f6b33; }
.notebox .nb-tag.check { background: #ececec; color: #5a5a5a; }
.notebox .nb-tag.ed { background: #e3eefa; color: #1d5c99; }
.notebox .nb-cite { color: var(--ink); }
.notebox .nb-src { margin-top: 5px; font-size: 12px; color: var(--ink-3); }
html.dark .notebox .nb-tag.ok { background: #1f3a25; color: #8fd19e; }
html.dark .notebox .nb-tag.check { background: #3a3a3a; color: #cfcfcf; }
html.dark .notebox .nb-tag.ed { background: #1d3550; color: #9cc8f2; }
/* editorial additions (text not from the report): untinted for readers; the editor's
   "Show sources" switch tints them so reviewers see what departs from the report */
html.show-prov .is-editorial, html.show-prov [data-ed] { background: rgba(76, 141, 214, .16); box-shadow: inset 3px 0 0 #4c8dd6; border-radius: 2px; }
html.show-prov [data-ed] { box-shadow: none; outline: 1px dashed #4c8dd6; outline-offset: 1px; }
.notebox a { color: var(--link); word-break: break-all; }

.chart-card { --cbpp-header-font: var(--chart-font); --cbpp-main-font: var(--chart-font); font-family: var(--chart-font); font-weight: 400; letter-spacing: 0; }
.chart-card.is-image { max-width: none; }
.chart-card { width: 100%; max-width: 660px; max-height: 100vh; margin: 0; padding: 16px 0; display: flex; flex-direction: column; }
.fig-label { font-family: "Figtree", "Helvetica", "Arial", sans-serif; font-weight: 600; font-size: 16px; line-height: 1.125; letter-spacing: .1875em; text-transform: uppercase; color: var(--ink-2); padding-bottom: 8px; border-bottom: 1.5px solid #7d7d7d; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.fig-label .dl { all: unset; cursor: pointer; display: inline-flex; color: var(--ink-3); padding: 2px; border-radius: 3px; letter-spacing: 0; }
.fig-label .dl:hover, .fig-label .dl:focus-visible { color: var(--ink); outline: 1px solid var(--rule); }
.fig-label .dl svg { width: 18px; height: 18px; }
.fig-label .dl.busy { opacity: .4; cursor: progress; }
/* offscreen copy of a chart, rendered in its full state for PNG export */
.export-stage { position: fixed; left: -10000px; top: 0; width: 680px; background: #fff; --t: 0ms;
  /* always the published (light) colors, even when the editor's dark mode is on */
  --ink: #1c1c1c; --ink-2: #4a4a4a; --ink-3: #7a7979; --rule: #cfcfcf; --rule-light: #e4e4e4; --paper: #ffffff; --link: #0c61a4; color: var(--ink); }
.export-stage .chart-card { max-height: none; padding: 20px 24px; background: #fff; }
.export-stage .chart-foot .credit { display: block !important; }
.chart-card h3 { font-family: var(--cbpp-header-font); font-weight: 700; font-size: clamp(19px, 2.2vw, 24px); line-height: 1.2; margin: 0 0 6px; }
.chart-sub { font-family: var(--chart-font-cond); font-weight: 300; font-size: 16px; color: var(--ink-2); margin: 0; line-height: 1.3; }
/* When CBPP's kit doesn't load, size Barlow Semi Condensed up 6.5% so it sits against Montserrat
   the way Proxima Nova Condensed sits against Proxima Nova (measured: +3% matches x-height, +10%
   matches relative width; 6.5% splits it). font-size-adjust works on x-height: 0.516 × 1.065. */
html.free-fonts .chart-card .viz, html.free-fonts .chart-sub { font-size-adjust: ex-height 0.549; }
html.free-fonts .slope text.head { font-size-adjust: none; }
/* everything drawn inside the chart (legends, labels, values) is condensed, as in CBPP's PNGs */
.chart-card .viz { --cbpp-header-font: var(--chart-font-cond); --cbpp-main-font: var(--chart-font-cond); font-family: var(--chart-font-cond); }
.chart-head { margin-bottom: 28px; }
.viz { position: relative; min-height: 0; flex: 0 1 auto; }
.chart-foot { margin-top: 12px; font-size: 12.5px; line-height: 1.4; color: var(--ink-3); }
.chart-foot p { margin: 0 0 4px; }
.chart-foot .credit { font-family: var(--chart-font); font-weight: 400; text-transform: uppercase; letter-spacing: .02em; font-size: 13.5px; line-height: 1.2; color: #8a8a8a; text-align: right; margin-top: 10px; padding-top: 6px; border-top: 1.5px solid #7d7d7d; white-space: nowrap; }
/* same footer as CBPP's official chart PNGs: dark gray rule, medium-gray caps, right-aligned */
.chart-foot details { margin-top: 4px; }
.chart-foot summary { cursor: pointer; color: var(--link); font-size: 12.5px; }
.chart-foot table { border-collapse: collapse; margin-top: 6px; font-size: 12.5px; color: var(--ink); }
.chart-foot th, .chart-foot td { border-bottom: 1px solid var(--rule-light); padding: 3px 10px 3px 0; text-align: left; }
.chart-foot td.num, .chart-foot th.num { text-align: right; font-variant-numeric: tabular-nums; }

/* ---------- waffle ---------- */
.waffle-wrap { display: flex; gap: 22px; align-items: center; }
.waffle { display: grid; gap: 2px; width: min(100%, 360px, 52vh); flex: 0 0 auto; }
.waffle .cell { aspect-ratio: 1; border-radius: 2px; background: #d9d6d0; transition: background-color var(--t) var(--ease), opacity var(--t) var(--ease); }
.legend { list-style: none; margin: 0; padding: 0; font-size: 15px; line-height: 1.3; }
.legend li { display: flex; gap: 10px; align-items: flex-start; margin: 0 0 12px; transition: opacity var(--t) var(--ease); }
.legend .sw { flex: 0 0 14px; height: 14px; margin-top: 3px; border-radius: 2px; border: 1px solid rgba(0,0,0,.12); }
.legend .lab b { font-family: var(--cbpp-header-font); font-weight: 400; color: var(--ink-2); }
.legend .val { display: block; font-family: var(--cbpp-header-font); font-weight: 400; font-size: 24px; line-height: 1.1; color: var(--ink); font-variant-numeric: tabular-nums; }
.legend .desc { display: block; color: var(--ink-3); font-size: 13.5px; }
.legend li.dim { opacity: .35; }
.legend li.on .val { font-weight: 700; }

/* ---------- pie ---------- */
.pie-wrap { display: flex; gap: 20px; align-items: center; }
.pie-wrap svg { width: min(100%, 320px, 48vh); flex: 0 0 auto; overflow: visible; }
.pie-wrap path { transition: opacity var(--t) var(--ease), transform var(--t) var(--ease); }
.pie-wrap text { font-family: var(--cbpp-header-font); font-weight: 400; font-size: 15px; fill: var(--ink); pointer-events: none; transition: opacity var(--t) var(--ease); }

/* ---------- bars ---------- */
.bars { display: grid; grid-template-columns: minmax(110px, 36%) 1fr; row-gap: 14px; column-gap: 12px; position: relative; }
.bars .blabel { text-align: right; font-size: 15px; line-height: 1.25; align-self: center; transition: opacity var(--t) var(--ease); }
.bars .track { position: relative; height: 48px; }
.bars .bar { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 0 4px 4px 0; transition: width var(--t) var(--ease), opacity var(--t) var(--ease); }
.bars .bval { position: absolute; top: 50%; transform: translateY(-50%); font-family: var(--cbpp-header-font); font-weight: 400; font-size: 20px; font-variant-numeric: tabular-nums; white-space: nowrap; transition: left var(--t) var(--ease), opacity var(--t) var(--ease); }
.bars .gap { grid-column: 1 / -1; height: 6px; }
.bars .axis { position: absolute; top: -4px; bottom: -4px; width: 0; border-left: 2px solid var(--ink); }
.bars { padding-bottom: 58px; }
.bars .bval.strong { font-weight: 600; }
.bars .bval { z-index: 2; background: var(--paper); padding: 0 3px; border-radius: 2px; }
.bars .bval.inside { background: none; }
.bars .ref.strong span { font-weight: 600; }
.bars .ref { position: absolute; top: -6px; bottom: -6px; width: 0; border-left: 2px dashed #b3b3b3; transition: left var(--t) var(--ease), opacity var(--t) var(--ease); pointer-events: none; }
.bars .ref span { z-index: 1; transition: font-weight var(--t), color var(--t); position: absolute; top: calc(100% + 4px); left: -2px; width: max-content; max-width: 220px; white-space: normal; line-height: 1.25; font-family: var(--cbpp-header-font); font-size: 13px; font-weight: 400; color: var(--ink-3); background: var(--paper); padding: 0 4px; }

/* ---------- slope ---------- */
.slope svg { width: 100%; max-height: 62vh; overflow: visible; display: block; }
.slope text { font-family: var(--cbpp-header-font); font-size: 15px; fill: var(--ink); transition: opacity var(--t) var(--ease); }
.slope text.val { font-weight: 400; font-size: 17px; }
.slope text.head { font-family: var(--chart-font); font-weight: 700; font-size: 16px; }
.slope .series { transition: opacity var(--t) var(--ease); }

/* ---------- stacked bar ---------- */
.stack-wrap { position: relative; }
.stack-body { position: relative; padding-top: 32px; }
.stack { display: flex; gap: 2px; height: 64px; }
.stack .seg { min-width: 0; display: flex; align-items: center; justify-content: center; transition: opacity var(--t) var(--ease); }
.stack .seg:first-child { border-radius: 4px 0 0 4px; } .stack .seg:last-child { border-radius: 0 4px 4px 0; }
.stack .seg span { font-family: var(--cbpp-header-font); font-weight: 400; font-size: 17px; color: var(--ink); pointer-events: none; }
.stack-legend { display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; margin: 0 0 6px; }
.stack-legend li { margin-bottom: 8px; }
.bracket { position: absolute; top: 8px; height: 14px; border: 1.5px solid #c4c4c4; border-bottom: 0; opacity: 0; transition: left var(--t) var(--ease), width var(--t) var(--ease), opacity var(--t) var(--ease); }
.bracket span { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-family: var(--cbpp-header-font); font-weight: 400; font-size: 15px; color: var(--ink-3); line-height: 1; background: var(--paper); padding: 0 6px; white-space: nowrap; }

/* ---------- image: gray-out regions + zoomable frame ---------- */
.imgframe { position: relative; overflow: hidden; width: 100%; }
.imginner { position: absolute; left: 0; top: 0; transform-origin: 0 0; transition: transform 800ms var(--ease); }
@media (prefers-reduced-motion: reduce) { .imginner { transition: none; } }
.imginner img { display: block; width: 100%; height: auto; }
.imginner .dimlayer { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.imginner .dimgroup { transition: opacity var(--t) var(--ease); }

/* ---------- editor mode (?edit): toolbar + dark mode. Never shown on the published page. ---------- */
.edit-bar { position: fixed; top: 12px; right: 12px; z-index: 60; width: 244px; background: #23272e; border: 1px solid #353b44; border-radius: 10px; box-shadow: 0 6px 20px rgba(0,0,0,.3); font: 600 12px/1.2 var(--cbpp-header-font); color: #fff; }
.edit-bar button { all: unset; box-sizing: border-box; cursor: pointer; }
.edit-bar button:focus-visible { outline: 2px solid #5fb3ae; outline-offset: 2px; border-radius: 6px; }
.edit-bar .eb-head { display: flex; align-items: center; justify-content: space-between; padding: 8px 8px 6px 12px; letter-spacing: .08em; text-transform: uppercase; font-size: 11px; color: rgba(255,255,255,.75); }
.edit-bar .eb-min { padding: 2px 8px; font-size: 18px; line-height: 1; color: #fff; border-radius: 6px; }
.edit-bar .eb-min:hover { background: rgba(255,255,255,.14); }
.edit-bar .eb-body { padding: 0 12px 12px; }
/* a setting: name on the left, a two-sided switch on the right (left label, track, right label) */
.edit-bar .eb-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 0; border-top: 1px solid rgba(255,255,255,.1); }
.edit-bar .eb-name { color: rgba(255,255,255,.8); font-weight: 600; }
.edit-bar .eb-sw { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 11px; }
.edit-bar .eb-sw .opt { color: rgba(255,255,255,.5); transition: color 120ms; }
.edit-bar .eb-sw[aria-checked="false"] .opt:first-child, .edit-bar .eb-sw[aria-checked="true"] .opt:last-child { color: #fff; }
.edit-bar .eb-sw .track { position: relative; width: 30px; height: 16px; border-radius: 999px; background: #4a505a; transition: background 150ms; flex: 0 0 auto; }
.edit-bar .eb-sw .knob { position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; transition: transform 150ms; }
.edit-bar .eb-sw[aria-checked="true"] .track { background: #2a7a77; }
.edit-bar .eb-sw[aria-checked="true"] .knob { transform: translateX(14px); background: #fff; }
.edit-bar .eb-seg { display: inline-flex; border-radius: 6px; background: rgba(0,0,0,.22); padding: 2px; gap: 2px; }
.edit-bar .eb-seg button { padding: 4px 8px; border-radius: 4px; font-size: 11px; color: rgba(255,255,255,.7); }
.edit-bar .eb-seg button:hover { color: #fff; }
.edit-bar .eb-seg button[aria-checked="true"] { background: #fff; color: #0c4645; }
.edit-bar .eb-sw-row { display: inline-flex; gap: 6px; }
.edit-bar .eb-swatch { width: 22px; height: 18px; border-radius: 4px; border: 2px solid transparent; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
.edit-bar .eb-swatch[aria-checked="true"] { border-color: #fff; }
.edit-bar .eb-row.off { opacity: .45; }
/* a side of a switch that can't be chosen right now (e.g. Proxima when the kit didn't load) */
.edit-bar .eb-sw .opt.locked { color: rgba(255,255,255,.28); text-decoration: line-through; }
.edit-bar .eb-sw[aria-disabled="true"] { cursor: not-allowed; }
.edit-bar .eb-sw[aria-disabled="true"] .track { opacity: .55; }
/* collapsible details under the action button */
.edit-bar .eb-more { display: flex; align-items: center; gap: 6px; width: 100%; margin-top: 8px; padding: 4px 0; color: rgba(255,255,255,.6); font-size: 11px; font-weight: 600; }
.edit-bar .eb-more:hover { color: #fff; }
.edit-bar .eb-more .chev { display: inline-block; width: 10px; transition: transform 150ms; }
.edit-bar .eb-more[aria-expanded="true"] .chev { transform: rotate(90deg); }
.edit-bar .eb-details { display: none; padding: 2px 0 0 16px; font-size: 11px; font-weight: 400; line-height: 1.45; color: rgba(255,255,255,.55); }
.edit-bar .eb-details.open { display: block; }
.edit-bar .eb-details p { margin: 0 0 6px; }
.edit-bar .eb-details b { color: rgba(255,255,255,.75); font-weight: 600; }
html.dark .edit-bar .eb-open { background: #a9afb8; color: #23272e; box-shadow: 0 0 0 1px #8e949e; }   /* inverted on dark pages */
/* an action, not a setting: filled button with a play icon */
.edit-bar .eb-run { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; margin-top: 10px; padding: 9px 10px; border-radius: 7px; background: #0c4645; color: #fff; font-weight: 700; }
.edit-bar .eb-run:hover { background: #083938; }
.edit-bar .eb-run svg { width: 12px; height: 12px; }
.edit-bar .eb-run[disabled] { opacity: .6; cursor: progress; }
/* minimized: just a round button in the corner */
.edit-bar.min { width: auto; border-radius: 999px; }
.edit-bar.min .eb-head, .edit-bar.min .eb-body { display: none; }
.edit-bar .eb-open { display: none; width: 34px; height: 34px; border-radius: 999px; background: #23272e; box-shadow: 0 0 0 1px #353b44; color: #fff; font-size: 15px; text-align: center; line-height: 34px; }
.edit-bar.min .eb-open { display: block; }
html.dark {
  --ink: #ececec; --ink-2: #c9c9c9; --ink-3: #9d9d9d; --rule: #474747; --rule-light: #34363a;
  --paper: #16181c; --paper-warm: #1d1f23; --link: #8cc0ee; color-scheme: dark;
}
/* top bar: a soft gray-blue rather than bright white — light enough for the navy logo */
html.dark .masthead { background: #23272e; border-bottom-color: #353b44; }
/* the CBPP logo is one navy color with see-through cutouts, so pure white is exact;
   meta.logoDark (a supplied white file) is used instead when present */
html.dark .masthead img { filter: brightness(0) invert(1); }
html.dark .masthead img.has-dark { display: none; }
.masthead img.logo-dark { display: none; }
html.dark .masthead img.logo-dark { display: inline-block; filter: none; }
html.dark .tags li { color: #6d9ccd; border-color: #4f7fb0; }
html.dark .tags li:first-child { color: #fff; border-color: var(--med-blue); }
/* charts and text cards sit on a slightly lifted panel so they separate from the page;
   redefining --paper inside them keeps label backgrounds (values, brackets, reference
   labels) matched to the panel. The report's PNG charts stay on their own white. */
html.dark .chart-card { --paper: #23272e; background: var(--paper); }
html.dark .step-card { --paper: #30353e; background: var(--paper); }   /* a step lighter than the charts, so a card over a chart stays distinct */
html.dark .chart-card { border-radius: 8px; padding-left: 16px; padding-right: 16px; }
html.dark .step-card { border-color: #454c57; box-shadow: 0 4px 18px rgba(0,0,0,.35); }
/* highlight color: meta.highlightColor or the editor's swatches (yellow / green / red) */
:root { --hl: var(--light-gold); }
html[data-hl="green"] { --hl: #cde6cc; }
html[data-hl="red"] { --hl: #f9cdd0; }
html[data-hl="blue"] { --hl: #c7e7f0; }   /* CBPP light blue */
html.dark { --hl: rgba(254,189,87,.38); }
html.dark[data-hl="green"] { --hl: rgba(127,183,126,.42); }
html.dark[data-hl="red"] { --hl: rgba(240,98,107,.38); }
html.dark[data-hl="blue"] { --hl: rgba(120,180,225,.38); }
html.dark .stack .seg span, html.dark .bars .bval.inside { color: #1c1c1c; }   /* dark text on the colored fills */
html.dark .slope circle { stroke: var(--paper); }
html.dark .slope .series line { stroke: #8d949e; }   /* the near-black connecting lines vanish on the dark panel */
html.dark .notebox { background: #30353d; border-color: #464c56; }
html.dark .tip { background: #000; }
@media (max-width: 899px) { html.dark .step-card { background: rgba(48,53,62,.97); } html.dark .chart-card { padding-left: 12px; padding-right: 12px; } }

/* ---------- tooltip ---------- */
.tip { position: fixed; z-index: 20; pointer-events: none; background: var(--ink); color: #fff; font-family: var(--cbpp-header-font); font-size: 13px; line-height: 1.35; padding: 6px 9px; border-radius: 4px; max-width: 240px; opacity: 0; transition: opacity 120ms; }
.tip.on { opacity: 1; }

/* ---------- footer ---------- */
.end { max-width: 640px; margin: 40px auto 0; padding: 24px 16px 64px; border-top: 1px solid var(--rule); font-size: 15px; color: var(--ink-2); }
.end .cta { display: inline-block; margin: 8px 0 16px; font-family: var(--cbpp-header-font); font-weight: 700; color: #fff; background: var(--dark-blue); padding: 10px 16px; border-radius: 3px; text-decoration: none; }

/* CBPP's small-screen type (under 450px) */
@media (max-width: 449px) {
  body { font-size: 16px; line-height: 1.5; }
  .hero h1 { font-size: 32px; line-height: 40px; }
  .prose h2 { font-size: 21px; }
}

/* ---------- mobile: graphic pinned, cards scroll over it ---------- */
@media (max-width: 899px) {
  .scrolly { display: block; padding: 0 16px; }
  /* chart pins to the top; cards enter from the bottom and scroll up over it */
  .graphic { height: 100vh; height: 100svh; align-items: flex-start; padding-top: 6px; }
  .chart-card { padding: 6px 0; }
  .chart-foot { font-size: 11px; margin-top: 8px; }
  .chart-foot .credit { font-size: 10.5px; margin-top: 6px; padding-top: 4px; white-space: normal; }
  .chart-head { margin-bottom: 18px; }
  .steps { margin-top: -100vh; margin-top: -100svh; padding: 0 0 20vh; pointer-events: none; }
  .step { min-height: 0; display: block; padding-top: 85vh; padding-top: 85svh; }
  .step-card { pointer-events: auto; opacity: 1; background: rgba(255,255,255,.97); padding: 12px 14px; box-shadow: 0 4px 18px rgba(0,0,0,.14); }
  .chart-card h3 { font-size: 18px; }
  .chart-sub { font-size: 14.5px; margin-bottom: 8px; }
  .waffle-wrap { gap: 12px; }
  .waffle { width: min(48vw, 34vh); }
  .pie-wrap { flex-direction: column; align-items: stretch; gap: 8px; }
  .pie-wrap svg { width: min(56vw, 30vh); align-self: center; }
  .pie-wrap .legend { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; }
  .legend { font-size: 12.5px; } .legend li { margin-bottom: 6px; } .legend .val { font-size: 17px; } .legend .desc { display: none; }
  .stack .seg span { font-size: 14px; }
  .stack { height: 52px; }
  .stack-legend { column-gap: 12px; }
  .slope svg { max-height: 50svh; }
  .bars { grid-template-columns: minmax(90px, 38%) 1fr; row-gap: 10px; }
  .bars .track { height: 38px; }
  .bars .blabel { font-size: 13px; }
  .bars .bval { font-size: 17px; }
}
</style>
