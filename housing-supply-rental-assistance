  if (m.logo) document.getElementById('masthead').innerHTML =
    `<a href="https://www.cbpp.org/"><img src="${m.logo}" alt="Center on Budget and Policy Priorities"${m.logoDark ? ' class="has-dark"' : ''}>` +
    (m.logoDark ? `<img class="logo-dark" src="${m.logoDark}" alt="Center on Budget and Policy Priorities">` : '') + `</a>`;
  document.getElementById('hero').innerHTML =
    `${(m.tags || (m.kicker ? [m.kicker] : [])).length ? `<ul class="tags">${(m.tags || [m.kicker]).map(t => `<li>${esc(t)}</li>`).join('')}</ul>` : ''}<h1>${esc(m.title)}</h1>` +
    `${m.dek ? `<p class="dek">${m.dek}</p>` : ''}` +
    `<div class="byline">${m.author ? `By <strong>${esc(m.author)}</strong> · ` : ''}${esc(m.date || '')}</div>` +
    `<p class="byline-note">${m.note || (m.url ? `Adapted from the <a href="${esc(m.url)}">full CBPP report</a>.` : '')}</p>`;
  wireSourcePdf();
}
function buildIndex() {
  const figs = STORY.sections.filter(sec => sec.type === 'scrolly');
  if (!figs.length || STORY.meta.index === false) return;
  const nav = h('nav', { class: 'toc', 'aria-label': 'Figures' });
  nav.innerHTML = `<p class="toc-head">${esc(STORY.meta.indexTitle || 'Figures in this chart book')}</p><ol>` +
    figs.map(sec => `<li><a href="#fig-${sec.figure.number}"><span class="toc-n">Fig. ${sec.figure.number}</span><span class="toc-t">${esc(sec.figure.title)}</span></a></li>`).join('') + '</ol>';
  document.getElementById('hero').after(nav);
}
function buildFooter() {
  const m = STORY.meta, end = document.getElementById('end');
  end.innerHTML = `${m.url ? `<a class="cta" href="${esc(m.url)}">Read the full report</a>` : ''}` +
    `${m.credit ? `<p>${m.credit}</p>` : ''}`;   // provenance lives in the top note (meta.note)
}
function buildFigure(sec) {
  const f = sec.figure, isImg = f.chart.type === 'image';
  const card = h('figure', { class: 'chart-card' + (isImg ? ' is-image' : '') });
  const lab = h('div', { class: 'fig-label' }, `<span>Figure ${f.number}</span>`);
  if (STORY.meta.download !== false) {
    const dl = h('button', { class: 'dl', type: 'button', title: 'Download this chart as a PNG', 'aria-label': `Download Figure ${f.number} as a PNG` },
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 17v3h16v-3"/></svg>');
    dl.addEventListener('click', () => exportFigure(sec, dl));
    lab.appendChild(dl);
  }
  card.appendChild(lab);
  if (!isImg) {
    const head = h('div', { class: 'chart-head' });
    head.appendChild(h('h3', {}, esc(f.title)));
    if (f.subtitle) head.appendChild(h('p', { class: 'chart-sub' }, esc(f.subtitle)));
    card.appendChild(head);
  } else {
    card.appendChild(h('h3', { class: 'sr-only' }, esc(f.title)));
  }
  const viz = h('div', { class: 'viz' }); card.appendChild(viz);
  const foot = h('figcaption', { class: 'chart-foot' });
  if (!isImg) {
    (f.notes || []).forEach(n => foot.appendChild(h('p', {}, esc(n))));
    if (f.source) foot.appendChild(h('p', {}, esc(f.source)));
    foot.appendChild(h('div', { class: 'credit' }, 'Center on Budget and Policy Priorities | cbpp.org'));
  }
  card.appendChild(foot);
  const renderer = RENDERERS[f.chart.type];
  if (!renderer) throw new Error('Unknown chart type: ' + f.chart.type);
  const chart = renderer(viz, f.chart, foot);
  if (isImg && !foot.childNodes.length) foot.remove();
  return { card, chart };
}
function buildScrolly(sec) {
  const root = h('section', { class: 'scrolly', id: `fig-${sec.figure.number}`, 'aria-label': `Figure ${sec.figure.number}: ${sec.figure.title}` });
  const graphic = h('div', { class: 'graphic' });
  const { card, chart } = buildFigure(sec);
  graphic.appendChild(card);
  const steps = h('div', { class: 'steps' });
  const stepEls = sec.steps.map((st, i) => {
    const el = h('div', { class: 'step', 'data-i': i });
    const ed = isEditorial(st);
    const card = h('div', { class: 'step-card' + (st.html ? '' : ' pause') + (ed ? ' is-editorial' : '') }, st.html || '');
    if (ed) card.title = edTitle(st);
    el.appendChild(card);
    steps.appendChild(el); return el;
  });
  root.append(graphic, steps);
  const wrapper = h('div');
  wrapper.appendChild(root);
  let active = -1;
  const activate = i => {
    if (i === active) return; active = i;
    stepEls.forEach((el, k) => el.classList.toggle('is-active', k === i));
    chart.update(sec.steps[i].state || {});
  };
  // The active step is the last card whose top edge has passed the trigger line: mid-screen on
  // desktop, low on phones (so the card sits under the pinned chart while it is read).
  // Position-based rather than IntersectionObserver so fast scrolls and jumps can't skip a state.
  const cards = stepEls.map(el => el.querySelector('.step-card'));
  const states = sec.steps.map(st => st.state || {});
  const clamp = v => Math.max(0, Math.min(1, v));
  SCROLLIES.push(() => {
    const line = innerHeight * (matchMedia('(max-width: 899px)').matches ? 0.75 : 0.5);
    const tops = cards.map(c => c.getBoundingClientRect().top);
    let i = 0;
    tops.forEach((t, k) => { if (t < line) i = k; });
    activate(i);
    if (chart.scrub) {
      // continuous position for scroll-linked charts: the move toward step k happens while card k
      // rises from the bottom of the screen to the trigger line (so the motion lands with its text)
      let pos;
      if (tops[0] >= line) pos = -1 + clamp((innerHeight - tops[0]) / (innerHeight - line));
      else pos = i + (i + 1 < tops.length ? clamp((innerHeight - tops[i + 1]) / (innerHeight - line)) : 0);
      const span = (innerHeight - line) + (tops[tops.length - 1] - tops[0]);
      const progress = clamp((innerHeight - tops[0]) / span);
      chart.scrub(pos, states, progress);
    }
  });
  activate(0);
  return wrapper;
}
// Editorial additions: text that is not from the report. Marked on a step, prose section or
// paragraph with "source": "editor" (older stories used "user"), or inline with <span data-ed>.
const isEditorial = o => !!o && (o.source === 'editor' || o.source === 'user');
const edTitle = o => 'Editorial addition' + (o.editor ? ` — ${[o.editor.by, o.editor.date].filter(Boolean).join(', ')}` : '');
function buildProse(sec) {
  const el = h('section', { class: 'prose' + (sec.variant ? ' ' + sec.variant : '') });
  if (sec.heading) el.appendChild(h('h2', {}, esc(sec.heading)));
  // a paragraph is report text (a string) or an object { "html", "source": "editor", "editor": {by, date} }
  (sec.paragraphs || []).forEach(p => {
    const obj = typeof p === 'string' ? { html: p } : p;
    const ed = isEditorial(sec) || isEditorial(obj);
    const para = h('p', ed ? { class: 'is-editorial', title: edTitle(isEditorial(obj) ? obj : sec) } : {}, obj.html);
    el.appendChild(para);
  });
  return el;
}
/* ===================== layout check =====================
   window.scrollyCheck() scrolls to every step of every figure at the current window size, waits for
   the chart to settle, and reports text that is cut off, runs off the screen or past its chart,
   overlaps other chart text, sits under the step card, or renders too small to read. Run it at
   phone widths (375 and 320) after every change; open the page with #check to see the report
   in a panel. Returns a list of { where, kind, text, detail }. */
window.scrollyCheck = async function ({ wait = 1000, minPx = 9 } = {}) {
  const issues = [], vw = document.documentElement.clientWidth;
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const visOpacity = el => { let o = 1; for (let e = el; e && e.nodeType === 1; e = e.parentElement) o *= +getComputedStyle(e).opacity; return o; };
  const textEls = root => [...root.querySelectorAll('*')].filter(e => {
    if (e.closest('.sr-only')) return false;
    if (e instanceof SVGElement) return e.tagName === 'text';
    return [...e.childNodes].some(n => n.nodeType === 3 && n.textContent.trim());
  }).filter(e => { const r = e.getBoundingClientRect(); return r.width > 0 && r.height > 0 && visOpacity(e) > 0.05; });
  const label = e => (e.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 60);
  const add = (where, kind, e, detail) => {
    const key = where.split(' · ')[0] + kind + label(e);
    if (!issues.some(x => x._k === key)) issues.push({ _k: key, where, kind, text: label(e), detail });
  };
  const check = (scope, where, stepCard) => {
    textEls(scope).forEach(e => {
      const r = e.getBoundingClientRect();
      if (r.right > vw + 1 || r.left < -1) add(where, 'off-screen', e, `spans x ${Math.round(r.left)}–${Math.round(r.right)} in a ${vw}px window`);
      // cut off by a box that hides overflow (or, for chart text, the edge of its SVG)
      for (let a = e.parentElement; a && a !== document.body; a = a.parentElement) {
        const cs = getComputedStyle(a);
        const clips = /hidden|clip|auto|scroll/.test(cs.overflowX + cs.overflowY) || (a.tagName === 'svg' && cs.overflow !== 'visible');
        if (a.tagName === 'svg' || clips) {
          const b = a.getBoundingClientRect();
          if (r.right > b.right + 1 || r.left < b.left - 1 || (clips && (r.bottom > b.bottom + 1 || r.top < b.top - 1))) {
            add(where, a.tagName === 'svg' ? 'outside chart' : 'cut off', e, `runs past its ${a.tagName === 'svg' ? 'SVG' : a.className || a.tagName} box by ${Math.round(Math.max(r.right - b.right, b.left - r.left, r.bottom - b.bottom, b.top - r.top))}px`);
            break;
          }
        }
      }
      const fs = e instanceof SVGElement ? parseFloat(getComputedStyle(e).fontSize) * (e.ownerSVGElement.getScreenCTM()?.a || 1) : parseFloat(getComputedStyle(e).fontSize);
      if (fs < minPx) add(where, 'too small', e, `renders at ${fs.toFixed(1)}px`);
      // notes/sources under the chart may sit beneath the card on short phones; they scroll into
      // view when the section ends, so only chart labels count here
      if (stepCard && scope.classList.contains('graphic') && !e.closest('.chart-foot')) {
        const c = stepCard.getBoundingClientRect();
        if (c.height && r.bottom > c.top + 2 && r.top < c.bottom - 2 && r.right > c.left && r.left < c.right && c.top < innerHeight)
          add(where, 'under step card', e, 'the active text card covers this label');
      }
    });
    // chart labels colliding with each other
    const els = textEls(scope.querySelector('.viz') || scope).map(e => [e, e.getBoundingClientRect()]);
    for (let i = 0; i < els.length; i++) for (let j = i + 1; j < els.length; j++) {
      const [a, ra] = els[i], [b, rb] = els[j];
      if (a.contains(b) || b.contains(a)) continue;
      const ox = Math.min(ra.right, rb.right) - Math.max(ra.left, rb.left), oy = Math.min(ra.bottom, rb.bottom) - Math.max(ra.top, rb.top);
      if (ox > 2 && oy > 3) add(where, 'overlap', a, `overlaps “${label(b)}”`);
    }
  };
  if (document.documentElement.scrollWidth > vw + 1) issues.push({ where: 'page', kind: 'horizontal scroll', text: '', detail: `page is ${document.documentElement.scrollWidth}px wide in a ${vw}px window` });
  check(document.getElementById('hero'), 'header');
  document.querySelectorAll('.prose').forEach((p, k) => check(p, `prose ${k + 1}`));
  const y0 = scrollY;
  for (const sec of document.querySelectorAll('section.scrolly')) {
    const n = sec.id.replace('fig-', ''), cards = [...sec.querySelectorAll('.step-card')];
    for (let k = 0; k < cards.length; k++) {
      const line = innerHeight * (matchMedia('(max-width: 899px)').matches ? 0.75 : 0.5);
      scrollTo({ top: scrollY + cards[k].getBoundingClientRect().top - line + 4, behavior: 'instant' });   // not smooth: measure where we land
      await sleep(wait);
      const where = `Figure ${n} · card ${k + 1}`;
      check(sec.querySelector('.graphic'), where, cards[k].classList.contains('pause') ? null : cards[k]);
      check(cards[k], where);
    }
  }
  scrollTo({ top: y0, behavior: 'instant' });
  issues.forEach(x => delete x._k);
  return issues;
};
if (location.hash === '#check') addEventListener('load', async () => {
  const res = await window.scrollyCheck();
  const box = h('div', { style: 'position:fixed;left:8px;right:8px;bottom:8px;max-height:45vh;overflow:auto;z-index:99;background:#fff;border:2px solid #c00;padding:10px;font:12px/1.4 monospace' });
  box.innerHTML = `<b>Layout check at ${document.documentElement.clientWidth}px: ${res.length ? res.length + ' issue(s)' : 'no issues'}</b>` +
    res.map(x => `<div>${esc(x.where)} — <b>${esc(x.kind)}</b>: ${esc(x.text)} <i>${esc(x.detail)}</i></div>`).join('');
  document.body.appendChild(box);
});
const SCROLLIES = [];
let ticking = false;
const onScroll = () => { if (ticking) return; ticking = true; requestAnimationFrame(() => { ticking = false; SCROLLIES.forEach(f => f()); }); };
addEventListener('scroll', onScroll, { passive: true });
addEventListener('resize', onScroll);
(function init() {
  if (!STORY) { document.body.innerHTML = '<p style="padding:40px">No story data. Build this page with scripts/build.py.</p>'; return; }
  buildHero();
  buildIndex();
  const main = document.getElementById('story');
  STORY.sections.forEach(sec => main.appendChild(sec.type === 'scrolly' ? buildScrolly(sec) : buildProse(sec)));
  buildFooter();
  wireNotes();
  if (STORY.meta.sourceStyle === 'underline') document.documentElement.classList.add('src-underline');
  if (STORY.meta.highlightColor && STORY.meta.highlightColor !== 'yellow') document.documentElement.dataset.hl = STORY.meta.highlightColor;
  editorMode();
  onScroll();
})();
</script>
</body>
